#!/bin/bash
"""exec" python3 $0 "$@"
# vim: ft=python
"""

import sys
import argparse
import re
import logging
from pathlib import Path
import os.path

log_level_map = {
    "critical": logging.CRITICAL,
    "error": logging.ERROR,
    "warning": logging.WARNING,
    "info": logging.INFO,
    "debug": logging.DEBUG,
}

if sys.version_info < (3, 12):

    def relpath(path: Path, start: Path) -> Path:
        return Path(os.path.relpath(path, start))
else:

    def relpath(path: Path, start: Path) -> Path:
        return path.relative_to(start, walk_up=True)


if sys.version_info < (3, 9):

    def is_relative_to(p, o):
        # zip() would stop at the shorter operand, making a path that is only a
        # prefix of o test true and get treated as an orphan below.
        return p.parts[: len(o.parts)] == o.parts

else:

    def is_relative_to(p, o):
        return p.is_relative_to(o)


def link_target(src: Path, dst: Path) -> Path:
    """Link text written for dst: relative to dst's directory when src is absolute."""
    return relpath(src, dst.parent) if src.is_absolute() else src


class Operation:
    def __init__(self, src: Path, dst: Path, args):
        self._src = link_target(src, dst)
        self._dst = dst
        self._args = args

    def run(self) -> int:
        raise NotImplementedError


class CreateLink(Operation):
    def run(self) -> int:
        if self._args.delete:
            return 0
        logging.info("create link: %s -> %s", self._dst, self._src)
        if not self._args.simulate:
            self._dst.symlink_to(self._src)
        return 0


class GoodLink(Operation):
    def run(self) -> int:
        if not self._args.delete:
            return 0
        logging.info("remove link: %s -> %s", self._dst, self._src)
        if not self._args.simulate:
            self._dst.unlink()
        return 0


class RestyleLink(Operation):
    """Resolves to src already, but its text is not the form this tool writes."""

    def run(self) -> int:
        if self._args.delete:
            logging.info("remove link: %s -> %s", self._dst, self._src)
            if not self._args.simulate:
                self._dst.unlink()
            return 0
        logging.info("restyle link: %s -> %s", self._dst, self._src)
        if not self._args.simulate:
            self._dst.unlink()
            self._dst.symlink_to(self._src)
        return 0


class OrphanLink(Operation):
    def run(self) -> int:
        logging.info("remove orphan link: %s -> %s", self._dst, self._src)
        if not self._args.simulate:
            self._dst.unlink()
        return 0


class UpdateLink(Operation):
    def run(self) -> int:
        if self._args.delete:
            return 0
        logging.info("update link: %s -> %s", self._dst, self._src)
        if not self._args.simulate:
            self._dst.unlink()
            self._dst.symlink_to(self._src)
        return 0


class FileExists(Operation):
    def run(self) -> int:
        logging.warning(
            "non-symlink file exists at %s for source %s", self._dst, self._src
        )
        if self._args.delete:
            return 0
        if self._args.backup:
            new_path = self._dst.with_name(self._dst.name + self._args.backup)
            if new_path.exists():
                if self._args.force:
                    if new_path.is_dir() and not new_path.is_symlink():
                        logging.error(
                            '"%s" is an existing backup directory, refusing to '
                            "clobber, doing nothing",
                            new_path,
                        )
                        return 1
                    logging.warning("clobbering existing backup %s", new_path)
                else:
                    logging.error("backup path for %s exists, doing nothing", self._dst)
                    return 1
            logging.info("backing up %s to %s", self._dst, new_path)
            if not self._args.simulate:
                self._dst.rename(new_path)
        elif self._args.force:
            if self._dst.is_dir():
                logging.error(
                    '"%s" is an existing directory, refusing to remove, doing nothing',
                    self._dst,
                )
                return 1
            logging.info("removing existing destination %s", self._dst)
            if not self._args.simulate:
                self._dst.unlink()
        else:
            return 0
        logging.info("create link: %s -> %s", self._dst, self._src)
        if not self._args.simulate:
            self._dst.symlink_to(self._src)
        return 0


class CreateDir(Operation):
    def run(self) -> int:
        if self._args.delete:
            return 0
        if self._dst.exists():
            return 0
        logging.info("creating dir: %s", self._dst)
        if not self._args.simulate:
            self._dst.mkdir()
        return 0


class CleanupDir(Operation):
    def run(self) -> int:
        if not self._dst.exists():
            return 0
        if [q for q in self._dst.iterdir()]:
            return 0
        logging.info("removing empty dir: %s", self._dst)
        if not self._args.simulate:
            self._dst.rmdir()
        return 0


def collect_operations(args, src=None, dst=None):
    if src is None:
        src = args.src
    if dst is None:
        dst = args.dst
    if src.is_dir() and not (src / ".linkdir").exists():
        subs = {s.name for s in src.iterdir()}
        yield CreateDir(src, dst, args)
        if dst.exists():
            subs.update({s.name for s in dst.iterdir()})
        if not subs:
            return
        for sub in subs:
            src_sub = src / sub
            dst_sub = dst / sub
            if any(bool(x.match(src_sub.as_posix())) for x in args.ignore_path) or any(
                bool(x.match(dst_sub.as_posix())) for x in args.ignore_path
            ):
                continue
            yield from collect_operations(args, src_sub, dst_sub)
        yield CleanupDir(src, dst, args)
        return
    # A dangling symlink in the source tree is still an entry to mirror, and
    # exists() follows the link, so it needs testing separately.
    if src.exists() or src.is_symlink():
        if dst.exists():
            if dst.is_symlink():
                if not dst.samefile(src):
                    yield UpdateLink(src, dst, args)
                elif os.readlink(dst) == str(link_target(src, dst)):
                    yield GoodLink(src, dst, args)
                else:
                    yield RestyleLink(src, dst, args)
            else:
                yield FileExists(src, dst, args)
        else:  # not dst.exists()
            if dst.is_symlink():
                # dst is dangling, either because it points somewhere else or
                # because src is itself a dangling link it already mirrors
                if os.readlink(dst) == str(link_target(src, dst)):
                    yield GoodLink(src, dst, args)
                else:
                    yield UpdateLink(src, dst, args)
            else:
                yield CreateLink(src, dst, args)
    else:  # src is absent rather than dangling
        if not dst.exists():
            if dst.is_symlink():
                r = dst.resolve()
                if is_relative_to(r, args.src):
                    yield OrphanLink(src, dst, args)
            else:
                logging.warning(
                    'source: "%s" does not exist and destination "%s" does not exist and is not a symlink',
                    src,
                    dst,
                )
        # else: # don't care about this entry


def main():
    argparser = argparse.ArgumentParser(
        description="Create and manage a link farms",
        epilog="A source directory containing a file named .linkdir is linked as a "
        "single symlink rather than recreated in the destination and populated "
        "with a link per entry. --ignore-path does not apply below such a "
        "directory, and the .linkdir file appears in the destination through the "
        "link.",
    )

    argparser.add_argument(
        "-l",
        "--log-level",
        help="specify log level",
        default="info",
        type=str,
        choices=log_level_map.keys(),
    )

    argparser.add_argument(
        "--ignore-path",
        "-x",
        help="paths to ignore",
        type=re.compile,
        action="append",
        default=[],
    )

    argparser.add_argument(
        "-d",
        "--delete",
        action="store_true",
        help="remove links instead of creating them",
    )

    argparser.add_argument(
        "-n",
        "--simulate",
        action="store_true",
        help="report what would be done and do nothing",
    )

    argparser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="overwrite an existing backup file; when --backup is empty, remove the "
        "existing destination instead of leaving it in place",
    )

    argparser.add_argument(
        "--backup",
        type=str,
        default=".bak",
        help="suffix appended when moving an existing non-symlink destination aside "
        "before linking; empty disables backups, in which case an existing "
        "destination is left in place unless --force is given (default: %(default)r)",
    )

    argparser.add_argument("src", type=Path, help="directory to link to")

    argparser.add_argument(
        "dst",
        type=Path,
        help="directory to put links in",
        nargs="?",
        default=Path.cwd(),
    )

    args = argparser.parse_args()
    logging.basicConfig(level=log_level_map[args.log_level])

    if not args.src.exists():
        logging.critical('source "%s" does not exist, nothing to do', args.src)
        sys.exit(1)
    else:
        args.src = args.src.resolve()
    if not args.dst.exists():
        logging.critical('destination "%s" does not exist', args.dst)
        sys.exit(1)
    else:
        args.dst = args.dst.resolve()

    errors = sum(op.run() for op in collect_operations(args))
    if errors > 0:
        logging.error("There were %d errors during operation", errors)
        sys.exit(1)


if __name__ == "__main__":
    main()
